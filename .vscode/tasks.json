{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Neocities: Push",
      "type": "shell",
      "command": "sudo neocities push ${workspaceFolder}\\dist",
      "dependsOn": ["Astro: Build"]
    },
    {
      "label": "Astro: Build",
      "type": "shell",
      "command": "yarn astro build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
