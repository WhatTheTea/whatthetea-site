---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  books: CollectionEntry<'books'>[];
}

const { books } = Astro.props;
---

<div 
  class="bookshelf-container  flex flex-col min-h-screen-sm"
  x-data="{ activeBook: null }"
>
  <!-- Shelf Items Grid -->
  <div class="shelf-grid">
    {
      books.map((book) => (
        <button
          class="book-item m-0 p-0"
          aria-label={`View details for ${book.data.title}`}
          @click={`activeBook = ${JSON.stringify(book)}`}>
          <Image src={book.data.coverImage} 
            alt={`Cover of ${book.data.title}`} 
            class="book-cover border-rd-0" />
        </button>
      ))
    }
  </div>

  <!-- Wooden Shelf Base -->
  <div class="shelf-bar"></div>

  <!-- Modal Overlay using x-teleport to escape layout clipping -->
  <template x-teleport="body">
    <div 
      class="modal-backdrop"
      x-show="activeBook"
      x-transition.opacity.duration.200ms
      @click.self="activeBook = null"
      @keydown.escape.window="activeBook = null"
      x-cloak
    >
      <div 
        class="modal-card"
        x-show="activeBook"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95 translateY-4"
        x-transition:enter-end="opacity-100 scale-100 translateY-0"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100 scale-100 translateY-0"
        x-transition:leave-end="opacity-0 scale-95 translateY-4"
      >
        <button 
          class="close-btn" 
          @click="activeBook = null"
          aria-label="Close details"
        >&times;</button>

        <template x-if="activeBook">
          <div class="modal-body">
            <img :src="activeBook.data.coverImage.src" :alt="activeBook.data.title" class="modal-cover" />
            <div class="modal-info">
              <h2 x-text="activeBook.data.title"></h2>
              <h3 x-text="'by ' + activeBook.data.author"></h3>
              <p class="meta">
                <!-- <strong>Pages:</strong> <span x-text="activeBook.data."></span> |  -->
                <!-- <strong>Rating:</strong> <span x-text="activeBook.rating"></span> -->
              </p>
              <p class="description" x-text="activeBook.body"></p>
            </div>
          </div>
        </template>
      </div>
    </div>
  </template>
</div>

<style>
  /* Hide elements with x-cloak until Alpine loads */
  [x-cloak] {
    display: none !important;
  }

  /* Bookshelf Container */
  .bookshelf-container {
    max-width: 900px;
    /* margin-top: ; */
    padding: 0 1rem;
  }

  .shelf-grid {
    display: flex;
    align-items: flex-end;
    /* padding: 2rem 2rem 0; */
  }

  /* Hover & Slide Effect */
  .book-item {
    background: none;
    border: none;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
    outline-offset: 4px;

    transform: rotateX(7deg) rotateY(-13deg);
  }

  .book-item + .book-item {
  margin-left: -9rem; /* Adjust this value to control overlap amount */
}

  .book-cover {
    /* width: 120px;
    height: 180px; */
    width: 12rem;
    object-fit: cover;
    box-shadow: -4px 4px 10px rgba(0, 0, 0, 0.3);
    display: block;
  }

  .book-cover:hover{
    border-left: none;
  }

  /* Slide up on hover/focus */
  .book-item:hover,
  .book-item:focus-visible {
    transform: translateY(-24px) scale(1.03);
    z-index: 1;
  }

  /* Wooden Shelf Base */
  .shelf-bar {
    height: 16px;
    background: linear-gradient(180deg, #8b5a2b 0%, #5c3a1e 100%);
    border-radius: 4px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    margin-top: -2px;
  }

  /* Modal Backdrop & Backdrop Filter */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  /* Modal Dialog Card */
  .modal-card {
    background: #ffffff;
    border-radius: 0px;
    padding: 2rem;
    position: relative;
    max-width: 550px;
    width: 100%;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
    color: #1a1a1a;
  }

  .close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.75rem;
    cursor: pointer;
    color: #666;
    line-height: 1;
  }

  .close-btn:hover {
    color: #000;
  }

  .modal-body {
    display: flex;
    gap: 1.5rem;
  }

  .modal-cover {
    width: 12em;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  }

  .modal-info h2 {
    margin: 0 0 0.25rem 0;
    font-size: 1.5rem;
  }

  .modal-info h3 {
    margin: 0 0 1rem 0;
    color: #666;
    font-weight: 400;
    font-size: 1.1rem;
  }

  .meta {
    font-size: 0.9rem;
    color: #555;
    margin-bottom: 0.75rem;
  }

  .description {
    line-height: 1.5;
    color: #333;
    font-size: 0.95rem;
  }

  @media (max-width: 600px) {
    .modal-body {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>